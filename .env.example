# Base de données (docker compose up -d)
DATABASE_URL="postgresql://jotoliko:jotoliko@localhost:5432/jotoliko"

# Cache et files de traitement
REDIS_URL="redis://localhost:6379"

# Authentification
JWT_SECRET="changez-moi"
JWT_REFRESH_SECRET="changez-moi-aussi"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# API
API_PORT=3001
API_BASE_URL="http://localhost:3001"

# Stockage des preuves de livraison (S3 compatible)
S3_ENDPOINT=""
S3_BUCKET="jotoliko-proofs"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Site marketing
NEXT_PUBLIC_BASE_PATH=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
