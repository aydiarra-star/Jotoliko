# Exemple de configuration — copier vers .env puis adapter.
#
# Règle : ce fichier ne liste que des variables réellement lues par le code.
# Une variable documentée mais ignorée ferait démarrer une configuration fausse
# en laissant croire qu'elle est prise en compte : c'est un piège de déploiement.
#
# Aucun secret réel ne doit figurer ici ni être versionné.

# ---------------------------------------------------------------------------
# Site public (Next.js) — utilisé par app/layout.tsx, sitemap et robots
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://jotoliko.com"
# URL publique de l’API NestJS utilisée par la page /inscription (valeur injectée au build statique).
# Exemple de forme uniquement : https://api.votre-domaine.tld — renseigner l’URL réelle du déploiement.
NEXT_PUBLIC_API_BASE_URL=""
# Préfixe lorsque le site est servi sous un sous-chemin (ex. GitHub Pages).
NEXT_PUBLIC_BASE_PATH=""

# ---------------------------------------------------------------------------
# API NestJS (apps/api) — la configuration est validée au démarrage : une valeur
# manquante, trop courte ou incohérente empêche le serveur de se lancer.
# ---------------------------------------------------------------------------

# Connexion PostgreSQL. Obligatoire. Doit commencer par postgres:// ou postgresql://.
DATABASE_URL="postgresql://jotoliko:jotoliko@localhost:5432/jotoliko"

# Secret de signature des jetons d'accès. Obligatoire, 32 caractères minimum.
# En production, une valeur d'exemple connue (« changez-moi », « changeme »…) est
# refusée au démarrage. Générer par exemple : openssl rand -base64 48
AUTH_SECRET=""

# Origines navigateur autorisées, séparées par des virgules. Obligatoire.
# Aucun repli permissif : sans valeur, aucune origine n'est autorisée.
# « * » est refusé en production.
CORS_ORIGIN="http://localhost:3000"

# Port d'écoute de l'API. Défaut : 4000.
PORT=4000

# Nombre de proxies de confiance devant l'API (0 = aucune). Défaut : 0.
# À 0, l'en-tête X-Forwarded-For est ignoré : un client direct ne peut pas
# falsifier son adresse pour contourner la limitation de débit.
# Derrière un répartiteur de charge, indiquer le nombre réel de proxies :
# sinon tous les utilisateurs partagent le quota d'une seule adresse.
TRUST_PROXY_HOPS=0

# Répertoire des preuves de livraison. Obligatoire en production.
# Les fichiers sont écrits sur ce chemin (volume persistant), et non dans un
# stockage objet : un chemin éphémère les perdrait à chaque redéploiement.
# Sauvegarde : ce répertoire doit être sauvegardé en même temps que la base —
# une sauvegarde de la base seule conserve les références, pas les fichiers.
PROOF_STORAGE_DIR="./var/proofs"

# Seuil d'espace libre du volume de preuves, en octets. Défaut : 268435456 (256 Mio).
# En dessous, `/health/ready` renvoie 503 avec `storage: ESPACE_INSUFFISANT` :
# l'instance est retirée du routage avant qu'un livreur ne se voie refuser un
# dépôt de preuve faute de place. Ajuster à la taille réelle des preuves.
PROOF_STORAGE_MIN_FREE_BYTES=268435456

# PayDunya Checkout (API uniquement). Les secrets restent dans l'environnement
# du serveur, jamais dans NEXT_PUBLIC_* ni dans le dépôt.
# Le mode sandbox est le défaut ; le live exige PAYDUNYA_ALLOW_LIVE=true.
PAYDUNYA_MODE="sandbox"
PAYDUNYA_ALLOW_LIVE="false"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
# URLs publiques HTTPS. Le callback doit pointer vers /billing/paydunya/callback.
PAYDUNYA_CALLBACK_URL=""
PAYDUNYA_RETURN_URL=""
PAYDUNYA_CANCEL_URL=""

# ---------------------------------------------------------------------------
# Scripts d'exploitation (ops/) — lus par `ops/backup.mjs`, `ops/restore-verify.mjs`
# et `ops/prune-proofs.mjs`, jamais par l'API. Voir docs/OPERATIONS-RUNBOOK.md.
# ---------------------------------------------------------------------------

# Destination des sauvegardes. Obligatoire pour sauvegarder. Sur un support
# distinct de la production, sinon la sauvegarde disparaît avec ce qu'elle protège.
BACKUP_DIR=""

# Chiffrement des sauvegardes : `none` ou `openssl-aes256`.
BACKUP_ENCRYPTION="none"

# Fichier contenant la phrase de chiffrement. Obligatoire si le chiffrement est actif.
# Doit être en mode 600 : une clé lisible par tous voyage avec la sauvegarde, et le
# chiffrement ne protège alors plus rien. Ne jamais versionner ce fichier.
BACKUP_ENCRYPTION_KEY_FILE=""

# Rétention : nombre de sauvegardes récentes conservées, puis nombre de jours
# d'archive distincts conservés. La sauvegarde la plus récente n'est jamais purgée.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Espace libre minimal exigé sur BACKUP_DIR avant d'écrire, en octets. Défaut : 512 Mio.
BACKUP_MIN_FREE_BYTES=536870912

# Commande exécutée en cas d'échec de sauvegarde (alerte). Vide = aucune alerte
# n'est transmise, et le script l'indique explicitement dans sa sortie.
BACKUP_ALERT_COMMAND=""

# Répertoire des clients PostgreSQL (pg_dump, pg_restore) lorsque l'ordonnanceur
# fournit un PATH minimal — cas de cron et systemd.
PG_BIN_DIR=""

# Adresse de l'API pour la sonde de supervision `ops/healthcheck.mjs`.
# Codes de sortie : 0 disponible, 1 dégradé, 2 injoignable.
API_BASE_URL=""

# ---------------------------------------------------------------------------
# Non implémenté — ne pas déployer en s'appuyant sur ces variables.
#
# Les mécanismes suivants ne sont pas développés à ce jour ; les variables
# correspondantes (JWT_SECRET, JWT_REFRESH_SECRET, REDIS_URL, S3_ENDPOINT,
# S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY) ne sont lues par aucun code et ont
# donc été retirées de cet exemple. Le stockage des preuves est aujourd'hui
# local (PROOF_STORAGE_DIR), et l'authentification utilise AUTH_SECRET.
#
# Un fournisseur de paiement mobile money n'est pas non plus configuré : les
# encaissements sont enregistrés comme déclarations d'exploitation, sans appel
# à un opérateur externe (voir docs/SECURITY-MODEL.md et le rapport de
# préparation).
# ---------------------------------------------------------------------------
