{
  "name": "jotoliko-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/reality/database.reality.test.ts",
    "test:e2e:api": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "api:build": "npm --prefix apps/api run build",
    "api:prisma:generate": "npm --prefix apps/api run prisma:generate",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "description": "Jotoliko — site marketing, invariants métier partagés et tests de réalité"
}
