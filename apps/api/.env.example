# Connexion PostgreSQL. Base dédiée par environnement (staging ≠ production).
DATABASE_URL="postgresql://jotoliko:jotoliko@localhost:5432/jotoliko?schema=public"

# Secret de signature des jetons. 32 caractères minimum.
# Générer avec : openssl rand -hex 32
AUTH_SECRET=""

# Origines navigateur autorisées, séparées par des virgules.
# Obligatoire : aucune origine n'est autorisée par défaut.
CORS_ORIGIN="http://localhost:3000"

PORT=4000
