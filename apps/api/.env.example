# Connexion PostgreSQL. Base dédiée par environnement (staging ≠ production).
DATABASE_URL="postgresql://jotoliko:jotoliko@localhost:5432/jotoliko?schema=public"

# Secret de signature des jetons. 32 caractères minimum.
# Générer avec : openssl rand -hex 32
AUTH_SECRET=""

# Origines navigateur autorisées, séparées par des virgules.
# Obligatoire : aucune origine n'est autorisée par défaut.
CORS_ORIGIN="http://localhost:3000"

PORT=4000

# PayDunya Checkout (API uniquement). Ne jamais exposer ces clés au navigateur.
# Le sandbox est le défaut ; en production, seuls les paiements live sont autorisés.
PAYDUNYA_MODE="sandbox"
PAYDUNYA_ALLOW_LIVE="false"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_CALLBACK_URL=""
PAYDUNYA_RETURN_URL=""
PAYDUNYA_CANCEL_URL=""
