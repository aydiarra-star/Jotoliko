generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionStatus {
  A_AFFECTER
  AFFECTEE
  EN_ROUTE
  ARRIVE
  LIVREE
  ECHEC
  REPROGRAMMEE
  RETOUR
}

enum TruthStatus {
  REEL
  ESTIME
  DERNIERE_POSITION_CONNUE
  INDISPONIBLE
  A_VERIFIER
  CONFIRME
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  missions  Mission[]
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  email     String
  name      String
  role      String\n  passwordHash String?\n  passwordSalt String?
  createdAt DateTime @default(now())

  @@unique([companyId, email])
  @@index([companyId, role])
}

model Mission {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  reference     String
  clientName    String
  phone         String?
  status        MissionStatus @default(A_AFFECTER)
  city          String?
  quartier      String?
  zone          String?
  writtenAddress String?
  landmark      String?
  accessInstructions String?
  latitude      Float?
  longitude     Float?
  gpsTruth      TruthStatus   @default(INDISPONIBLE)
  gpsAt         DateTime?\n  proofId       String?\n  assignedUserId String?\n  @@index([companyId, assignedUserId])
  expectedAmount Int           @default(0)
  collectedAmount Int         @default(0)
  remittedAmount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, gpsAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  actorUserId String?
  action     String
  objectType String
  objectId   String
  source     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  @@index([companyId, objectType, objectId])
  @@index([companyId, createdAt])
}

model MutationKey {
  idempotencyKey String @id
  companyId String
  operation String
  resultJson String
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
