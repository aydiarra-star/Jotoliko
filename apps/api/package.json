{
  "name": "@jotoliko/api",
  "private": true,
  "version": "0.1.0",
  "description": "API NestJS Jotoliko OS — opérations, caisse et preuves de livraison",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema ../../prisma/schema.prisma",
    "local:prisma-stub": "node scripts/local-prisma-stub.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  }
}
