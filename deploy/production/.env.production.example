# TEMPLATE ONLY. Copy to .env.production on the server and replace every
# placeholder. Never commit the populated file or send it in chat/tickets.
API_DOMAIN=api.example.com
# Generate a URL-safe database password: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_HEX_SECRET
# Generate a distinct API secret: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
# Exact browser origin(s) of the frontend, comma-separated. No trailing slash.
CORS_ORIGIN=https://jotoliko.example
# Use a persistent directory on the server; create it with UID/GID 1000.
PROOF_STORAGE_HOST_PATH=/srv/jotoliko/proofs
# Caddy is one trusted reverse proxy in this topology.
TRUST_PROXY_HOPS=1

# PayDunya Checkout — leave disabled until the merchant account is approved.
# In production, PAYDUNYA_MODE must be "live" and PAYDUNYA_ALLOW_LIVE must be "true".
PAYDUNYA_MODE=live
PAYDUNYA_ALLOW_LIVE=false
PAYDUNYA_MASTER_KEY=REPLACE_WITH_PAYDUNYA_MASTER_KEY
PAYDUNYA_PRIVATE_KEY=REPLACE_WITH_PAYDUNYA_PRIVATE_KEY
PAYDUNYA_TOKEN=REPLACE_WITH_PAYDUNYA_TOKEN
PAYDUNYA_CALLBACK_URL=https://api.example.com/billing/paydunya/callback
PAYDUNYA_RETURN_URL=https://jotoliko.example/inscription/retour
PAYDUNYA_CANCEL_URL=https://jotoliko.example/inscription/annulee
