// Jotoliko — modèle de données MVP
//
// Principes structurants :
//  1. Multi-tenant : toute donnée métier porte un companyId. Aucune requête ne
//     doit traverser les entreprises.
//  2. Offline-first : les entités créées sur le terrain (livraisons, encaissements,
//     preuves) portent un identifiant généré côté client (clientId) et des
//     métadonnées de synchronisation.
//  3. Cash : le livreur encaisse, puis reverse. La remise de caisse (Settlement)
//     est une entité de premier plan, pas un champ dérivé.
//  4. Traçabilité : les changements de statut de commande sont historisés.

// Schéma canonique unique du produit.
//
// Il n'existe qu'UN seul schéma Prisma dans ce dépôt. Le schéma secondaire
// `apps/api/prisma/schema.prisma` qui dupliquait une partie du modèle (et
// omettait Settlement, Proof, Payment, clientId et les métadonnées offline) a
// été fusionné ici : ses apports réels (Mission, TruthStatus, AuditEvent,
// MutationKey) sont conservés plus bas.
//
// L'API génère son client depuis ce fichier :
//   cd apps/api && npm run prisma:generate
// soit : prisma generate --schema ../../prisma/schema.prisma
//
// `output` cible explicitement `apps/api/node_modules/.prisma/client` afin que
// `import { PrismaClient } from "@prisma/client"` se résolve correctement dans un
// dépôt où le schéma vit à la racine (la résolution par défaut viserait la
// racine et l'API ne trouverait pas son client).

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité & tenants
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String   @default("SN")
  currency  String   @default("XOF")
  timezone  String   @default("Africa/Dakar")
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  drivers       Driver[]
  vehicles      Vehicle[]
  customers     Customer[]
  zones         Zone[]
  orders        Order[]
  deliveries    Delivery[]
  payments      Payment[]
  settlements   Settlement[]
  auditLogs     AuditLog[]
  notifications Notification[]
  settings      Setting?
  missions      Mission[]
  cashMovements CashMovement[]
  proofFiles    ProofFile[]
  subscriptions Subscription[]

  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  // Sel aléatoire par utilisateur. Un sel global ou dérivé d'un secret
  // permettrait de précalculer une table de correspondance pour tous les comptes.
  passwordSalt String
  // Incrémenter invalide instantanément tous les jetons déjà émis pour cet
  // utilisateur (déconnexion forcée, suspicion de compromission).
  tokenVersion Int       @default(0)
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships     Membership[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  driverProfile   Driver?
  assignedMissions Mission[]   @relation("MissionAssignee")
  uploadedProofs  ProofFile[]  @relation("ProofUploader")

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  roleId    String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Role {
  id          String  @id @default(uuid())
  code        String  @unique // OWNER, MANAGER, DISPATCHER, ACCOUNTANT, DRIVER
  label       String
  description String?

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

model Permission {
  id    String @id @default(uuid())
  code  String @unique // orders:create, settlements:validate, reports:read ...
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Référentiels terrain
// ---------------------------------------------------------------------------

model Zone {
  id        String   @id @default(uuid())
  companyId String
  name      String
  city      String?
  // Contour approximatif ; les repères libres restent la source de vérité terrain.
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers Customer[]
  orders    Order[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("zones")
}

model Vehicle {
  id        String   @id @default(uuid())
  companyId String
  plate     String?
  label     String // "Moto Yamaha 125", "Camionnette"
  type      String   @default("MOTORCYCLE") // MOTORCYCLE, CAR, VAN, TRUCK, BICYCLE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drivers Driver[]

  @@index([companyId])
  @@map("vehicles")
}

model Driver {
  id        String    @id @default(uuid())
  companyId String
  userId    String?   @unique // accès à l'application livreur
  vehicleId String?
  code      String // matricule interne affiché sur les bordereaux
  firstName String
  lastName  String
  phone     String
  isActive  Boolean   @default(true)
  hiredAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]
  settlements Settlement[]
  positions   DriverPosition[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("drivers")
}

model DriverPosition {
  id         String   @id @default(uuid())
  driverId   String
  lat        Float
  lng        Float
  accuracy   Float?
  battery    Int?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@map("driver_positions")
}

model Customer {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  phone       String
  email       String?
  // Adressage réel : point GPS + repère libre + zone. Les trois coexistent.
  addressLine String?
  landmark    String? // "derrière la pharmacie Mermoz, immeuble bleu"
  zoneId      String?
  lat         Float?
  lng         Float?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zone    Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  orders  Order[]

  @@index([companyId, phone])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

model Order {
  id         String      @id @default(uuid())
  companyId  String
  customerId String
  zoneId     String?
  reference  String // CMD-2418
  status     OrderStatus @default(DRAFT)

  // Montants en unité monétaire entière (FCFA : pas de centimes).
  subtotal    Int @default(0)
  deliveryFee Int @default(0)
  discount    Int @default(0)
  total       Int @default(0)
  amountDue   Int @default(0) // ce que le livreur doit collecter

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  isPaid        Boolean       @default(false)
  paidAt        DateTime?

  scheduledFor DateTime?
  notes        String?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  zone          Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  delivery      Delivery?
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String?
  label     String // libellé libre : beaucoup de clients n'ont pas de catalogue
  quantity  Int     @default(1)
  unitPrice Int     @default(0)
  lineTotal Int     @default(0)
  notes     String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id        String   @id @default(uuid())
  companyId String
  sku       String?
  name      String
  unitPrice Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items OrderItem[]

  @@index([companyId])
  @@map("products")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CASH_UPFRONT
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  BANK_TRANSFER
  CREDIT
}

// ---------------------------------------------------------------------------
// Livraison & preuve
// ---------------------------------------------------------------------------

model Delivery {
  id        String  @id @default(uuid())
  companyId String
  orderId   String  @unique
  driverId  String?
  // Identifiant généré sur le téléphone : permet de créer la livraison hors ligne.
  clientId  String? @unique

  status   DeliveryStatus @default(PENDING)
  sequence Int? // position dans la tournée

  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  // Métadonnées de synchronisation offline-first.
  recordedAt DateTime? // horodatage terrain (heure du téléphone)
  syncedAt   DateTime? // heure d'arrivée serveur
  deviceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  proofs  Proof[]
  payment Payment?

  @@index([companyId, status])
  @@index([driverId, status])
  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model Proof {
  id            String    @id @default(uuid())
  deliveryId    String
  type          ProofType @default(PHOTO)
  fileUrl       String?
  // Preuve de réception : qui a pris livraison.
  recipientName String?
  signatureUrl  String?
  note          String?
  lat           Float?
  lng           Float?
  clientId      String?   @unique
  recordedAt    DateTime
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("proofs")
}

enum ProofType {
  PHOTO
  SIGNATURE
  RECIPIENT_NAME
  NOTE
}

// ---------------------------------------------------------------------------
// Encaissements & caisse
// ---------------------------------------------------------------------------

model Payment {
  id         String  @id @default(uuid())
  companyId  String
  orderId    String
  deliveryId String? @unique
  driverId   String?

  amount Int
  method PaymentMethod @default(CASH_ON_DELIVERY)
  status PaymentStatus @default(PENDING)

  // Référence opérateur mobile money (Wave, OM, Free Money).
  externalRef String?
  clientId    String?   @unique
  collectedAt DateTime?
  recordedAt  DateTime?
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delivery     Delivery?   @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settlementId String?

  @@index([companyId, status])
  @@index([driverId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COLLECTED
  SETTLED
  DISPUTED
  CANCELLED
}

// Remise de caisse : ce que le livreur a collecté, ce qu'il reverse, l'écart.
model Settlement {
  id        String @id @default(uuid())
  companyId String
  driverId  String
  reference String

  periodStart DateTime
  periodEnd   DateTime

  expectedAmount Int // calculé depuis les paiements COLLECTED du livreur
  declaredAmount Int // déclaré par le livreur
  receivedAmount Int? // compté par l'entreprise
  variance       Int  @default(0) // receivedAmount - expectedAmount

  status            SettlementStatus @default(OPEN)
  note              String?
  validatedByUserId String?
  closedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver   Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([driverId, status])
  @@map("settlements")
}

enum SettlementStatus {
  OPEN
  SUBMITTED
  VALIDATED
  DISPUTED
  CLOSED
}

// ---------------------------------------------------------------------------
// Transverse
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String // orders.cancel, settlements.validate ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  // Identifiant de corrélation de la requête HTTP ayant produit la mutation.
  requestId  String?
  // Origine de la mutation : API, TERRAIN (reprise hors ligne), SYSTEME.
  source     String   @default("API")
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String              @id @default(uuid())
  companyId String
  userId    String?
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@map("notifications")
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
}

model Setting {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  // Seuils et politiques : tolérance d'écart de caisse, délai de conservation, etc.
  cashVarianceTolerance Int      @default(500)
  proofRequired         Boolean  @default(true)
  defaultDeliveryFee    Int      @default(0)
  data                  Json?
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Couche opérationnelle Jotoliko OS
//
// Ces modèles servent le centre des opérations (API NestJS) : une « mission »
// est le travail de livraison affecté à un livreur. Elle référence
// facultativement la commande documentée (`Order`) — l'unification complète
// Mission/Order/Delivery reste à faire et est suivie dans le rapport de release.
// ---------------------------------------------------------------------------

enum MissionStatus {
  A_AFFECTER
  AFFECTEE
  EN_ROUTE
  ARRIVE
  LIVREE
  ECHEC
  REPROGRAMMEE
  RETOUR
}

enum TruthStatus {
  REEL
  ESTIME
  DERNIERE_POSITION_CONNUE
  INDISPONIBLE
  A_VERIFIER
  CONFIRME
}

model Mission {
  id        String @id @default(uuid())
  companyId String
  // Identifiant métier stable, unique par entreprise : support des reprises
  // hors ligne et des impressions de bordereaux.
  reference String

  orderId String?

  clientName String
  phone      String?
  status     MissionStatus @default(A_AFFECTER)

  // Adressage terrain : quartier, zone, repère libre et instructions d'accès
  // coexistent avec la position GPS. Le repère libre reste la source de vérité
  // sur le terrain.
  country            String? @default("SN")
  city               String?
  quartier           String?
  zone               String?
  writtenAddress     String?
  landmark           String?
  accessInstructions String?

  // Position datée. `gpsTruth` empêche d'afficher une position périmée comme
  // actuelle : voir gpsTruthFromAge dans lib/jotoliko-os/core.ts.
  latitude  Float?
  longitude Float?
  gpsAt     DateTime?
  gpsTruth  TruthStatus @default(INDISPONIBLE)

  proofId String?

  assignedUserId String?

  // Montants en unité monétaire entière (FCFA sans subdivision).
  expectedAmount  Int @default(0)
  collectedAmount Int @default(0)
  remittedAmount  Int @default(0)

  // Métadonnées offline-first : horodatage terrain distinct de l'heure serveur.
  recordedAt DateTime?
  syncedAt   DateTime?
  deviceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedUser User?          @relation("MissionAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  payments     CashMovement[]
  proofFiles   ProofFile[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, assignedUserId, status])
  @@index([companyId, createdAt])
  @@map("missions")
}

// ---------------------------------------------------------------------------
// Caisse : journal immuable des mouvements d'espèces
//
// Les compteurs `collectedAmount` / `remittedAmount` de Mission sont des caches
// de lecture. La vérité comptable est ce journal : il permet de rejouer, auditer
// et expliquer un écart de caisse, ce que des compteurs seuls ne permettent pas.
// ---------------------------------------------------------------------------

enum CashMovementType {
  ENCAISSEMENT
  REMISE
  CORRECTION
  ANNULATION
}

model CashMovement {
  id         String           @id @default(uuid())
  companyId  String
  missionId  String
  driverId   String?
  type       CashMovementType
  // Toujours positif : le sens est porté par `type`.
  amount     Int
  note       String?
  actorUserId String

  // Idempotence : une même clé rejouée ne crée jamais un second mouvement.
  idempotencyKey String
  // Empreinte de la requête : une même clé avec un corps différent est rejetée
  // au lieu de renvoyer silencieusement un résultat qui ne correspond pas.
  requestHash    String

  // Horodatage double : heure de l'appareil vs heure serveur.
  recordedAt DateTime?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([missionId, type])
  @@index([companyId, driverId, createdAt])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Idempotence générique des mutations serveur
// ---------------------------------------------------------------------------

model MutationKey {
  id             String   @id @default(uuid())
  companyId      String
  // Espace de nommage : "<OPÉRATION>:<idRessource>" (voir operationScope).
  operation      String
  idempotencyKey String
  requestHash    String
  resultJson     String
  createdAt      DateTime @default(now())

  @@unique([companyId, operation, idempotencyKey])
  @@index([companyId, createdAt])
  @@map("mutation_keys")
}

// ---------------------------------------------------------------------------
// Preuves de livraison stockées
//
// `Mission.proofId` reste l'identifiant référencé par la mission : la preuve
// déposée vit ici. Stocker un identifiant sans stocker le fichier ne prouve
// rien — c'est pourquoi `storageKey`, `sha256`, `mimeType` et `sizeBytes` sont
// persistés avec le contenu, et pourquoi la clôture d'une livraison vérifie que
// l'identifiant correspond bien à un fichier réellement reçu.
//
// Le fichier n'est jamais exposé par une URL publique : il est lu par l'API,
// après contrôle du périmètre de l'appelant.
// ---------------------------------------------------------------------------

model ProofFile {
  id        String @id @default(uuid())
  companyId String
  missionId String
  /// Nature de la preuve (photo, signature, nom du récepteur, note).
  type      ProofType @default(PHOTO)

  mimeType String
  /// Taille réelle du contenu stocké, en octets.
  sizeBytes Int
  /// Empreinte du contenu : rend un doublon détectable sans relire le fichier.
  sha256    String
  /// Chemin relatif dans le stockage (entreprise/mission/empreinte.ext).
  /// Unique : deux dépôts identiques ne créent pas deux fichiers.
  storageKey String @unique

  uploadedByUserId String?
  recipientName    String?
  note             String?
  /// Position déclarée au moment du dépôt, distincte de celle de la mission.
  latitude  Float?
  longitude Float?

  /// Identifiant généré sur le téléphone : permet un dépôt hors ligne rejoué
  /// sans créer de doublon.
  clientId   String? @unique
  recordedAt DateTime?
  createdAt  DateTime @default(now())
  /// Suppression logique : la preuve reste auditable, la purge physique est une
  /// opération d'exploitation documentée.
  deletedAt DateTime?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mission    Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("ProofUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, missionId, sha256])
  @@index([companyId, missionId])
  @@map("proof_files")
}

// ---------------------------------------------------------------------------
// Journal d'audit des mutations sensibles
//
// Une seule table d'audit dans tout le produit (`audit_logs`, cf. AGENTS.md).
// La couche opérationnelle écrit donc dans `AuditLog` — pas dans une seconde
// table parallèle, qui aurait immanquablement divergé.
// ---------------------------------------------------------------------------



// ---------------------------------------------------------------------------
// Abonnements SaaS mensuels — ajout isolé, distinct des encaissements terrain
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SignupAttemptStatus {
  PENDING_PAYMENT
  ACTIVE
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
}

enum BillingPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model PlanPrice {
  id            String   @id @default(uuid())
  code          String
  version       Int
  currency      String   @default("XOF")
  unitPriceXof  Int
  effectiveFrom DateTime @default(now())
  effectiveUntil DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
  signupAttempts SignupAttempt[]

  @@unique([code, version])
  @@index([isActive, effectiveFrom, effectiveUntil])
  @@map("plan_prices")
}

model Subscription {
  id                     String             @id @default(uuid())
  companyId              String
  planPriceId            String
  seatLimit              Int
  status                 SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  gracePeriodEndsAt       DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  provider                String?
  providerCustomerRef     String?
  providerSubscriptionRef String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planPrice     PlanPrice      @relation(fields: [planPriceId], references: [id])
  billingPayments BillingPayment[]

  @@index([companyId, status])
  @@index([currentPeriodEnd])
  @@index([provider, providerSubscriptionRef])
  @@map("subscriptions")
}

model SignupAttempt {
  id            String              @id @default(uuid())
  companyName   String
  companySlug   String
  ownerEmail    String
  ownerFirstName String
  ownerLastName String
  passwordHash  String
  passwordSalt  String
  /// SHA-256 du jeton de reprise transmis une seule fois au client.
  /// Le jeton brut n'est jamais stocké en base.
  resumeTokenHash String? @unique
  seatCount     Int
  planPriceId   String
  status        SignupAttemptStatus @default(PENDING_PAYMENT)
  expiresAt     DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  planPrice     PlanPrice      @relation(fields: [planPriceId], references: [id])
  billingPayments BillingPayment[]

  @@index([ownerEmail, status])
  @@index([companySlug])
  @@index([status, expiresAt])
  @@map("signup_attempts")
}

model BillingPayment {
  id                String               @id @default(uuid())
  signupAttemptId   String?
  subscriptionId    String?
  provider          String
  providerReference String?
  amountXof         Int
  currency          String               @default("XOF")
  status            BillingPaymentStatus @default(PENDING)
  idempotencyKey    String               @unique
  rawEventHash      String?
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  signupAttempt SignupAttempt? @relation(fields: [signupAttemptId], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([signupAttemptId, status])
  @@index([subscriptionId, status])
  @@map("billing_payments")
}
